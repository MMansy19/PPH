<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background Gradient -->
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="1200" height="630" fill="url(#grad1)"/>
  
  <!-- Grid Pattern Background -->
  <g opacity="0.1">
    <line x1="0" y1="157.5" x2="1200" y2="157.5" stroke="white" stroke-width="1"/>
    <line x1="0" y1="315" x2="1200" y2="315" stroke="white" stroke-width="1"/>
    <line x1="0" y1="472.5" x2="1200" y2="472.5" stroke="white" stroke-width="1"/>
    <line x1="300" y1="0" x2="300" y2="630" stroke="white" stroke-width="1"/>
    <line x1="600" y1="0" x2="600" y2="630" stroke="white" stroke-width="1"/>
    <line x1="900" y1="0" x2="900" y2="630" stroke="white" stroke-width="1"/>
  </g>
  
  <!-- Logo Circle -->
  <circle cx="200" cy="315" r="100" fill="white" opacity="0.15"/>
  <circle cx="200" cy="315" r="80" fill="white"/>
  
  <!-- PFH Text in Logo -->
  <text x="200" y="335" font-family="system-ui, -apple-system, sans-serif" font-size="48" font-weight="bold" fill="#10B981" text-anchor="middle">PFH</text>
  
  <!-- Title Text -->
  <text x="350" y="260" font-family="system-ui, -apple-system, sans-serif" font-size="64" font-weight="bold" fill="white">
    Portfolio Financial Hub
  </text>
  
  <!-- Subtitle Text -->
  <text x="350" y="320" font-family="system-ui, -apple-system, sans-serif" font-size="28" fill="white" opacity="0.9">
    Economic Input/Output Management System
  </text>
  
  <!-- Feature Pills -->
  <g transform="translate(350, 360)">
    <rect x="0" y="0" width="180" height="40" rx="20" fill="white" opacity="0.2"/>
    <text x="90" y="27" font-family="system-ui" font-size="18" fill="white" text-anchor="middle">💰 Transactions</text>
    
    <rect x="200" y="0" width="160" height="40" rx="20" fill="white" opacity="0.2"/>
    <text x="280" y="27" font-family="system-ui" font-size="18" fill="white" text-anchor="middle">📊 Analytics</text>
    
    <rect x="380" y="0" width="150" height="40" rx="20" fill="white" opacity="0.2"/>
    <text x="455" y="27" font-family="system-ui" font-size="18" fill="white" text-anchor="middle">📈 Reports</text>
  </g>
  
  <!-- Chart Visualization -->
  <g transform="translate(900, 450)" opacity="0.6">
    <rect x="0" y="-80" width="40" height="80" rx="4" fill="white"/>
    <rect x="60" y="-120" width="40" height="120" rx="4" fill="white"/>
    <rect x="120" y="-100" width="40" height="100" rx="4" fill="white"/>
    <rect x="180" y="-140" width="40" height="140" rx="4" fill="white"/>
  </g>
</svg>
